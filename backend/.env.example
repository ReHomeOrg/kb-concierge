# kb-concierge — пример окружения (значения-плейсхолдеры; секреты — ссылкой на kb-vault)
KBC_DATABASE_URL=postgresql+asyncpg://kbconcierge:devpass@localhost:5435/kbconcierge
KBC_LOG_LEVEL=INFO
KBC_REDIS_URL=redis://localhost:6379/0
# Keycloak (пусто → fail-closed 401)
KBC_AUTH_JWKS_URL=
KBC_AUTH_ISSUER=
KBC_AUTH_AUDIENCE=kb-concierge
# OAuth2 исходящих вызовов (m2m + token-exchange on-behalf-of); пусто → dev
KBC_OAUTH_TOKEN_URL=
KBC_OAUTH_CLIENT_ID=
KBC_OAUTH_CLIENT_SECRET=
# Dramatiq broker (пусто → StubBroker, инертно)
KBC_WORKER_BROKER_URL=
